---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsSection from '../components/NewsSection.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { getCollection } from 'astro:content';
import { SITE, withBase } from '../lib/site';

const publications = await getCollection('publications');
const sortedPubs = publications
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const news = [
  { date: 'Sep 2026', text: 'New preprint: <a href="https://arxiv.org/abs/2609.20812">Quantifying Overclaiming Propensity in Frontier LLM Agents</a>.' },
  { date: 'Jul 2026', text: '<a href="https://arxiv.org/abs/2604.01329">Model Merging via Data-Free Covariance Estimation</a> accepted at the <strong>Conference on Language Modeling (COLM 2026)</strong>.' },
  { date: 'May 2026', text: 'New paper: <a href="https://arxiv.org/abs/2604.01329">Model Merging via Data-Free Covariance Estimation</a> accepted as <strong>Oral</strong> at the <strong>CATS (Continual Adaptation at Scale) Workshop, ICML 2026</strong>.' },
  { date: 'May 2026', text: 'Recognized as an <strong>ICML 2026 Gold Reviewer</strong> (top 25%) and awarded complimentary registration.' },
  { date: 'Apr 2026', text: `New paper: <a href="${withBase('/publications/grokking-finite-dimensional-algebra/')}">Grokking Finite-Dimensional Algebra</a> accepted at <strong>ICML 2026</strong>.` },
  { date: 'Jul 2025', text: `<a href="${withBase('/publications/grokking-beyond-l2/')}">Grokking Beyond the Euclidean Norm of Model Parameters</a> accepted at <strong>ICML 2025</strong>.` },
];
---

<BaseLayout
  title="Home"
  description="Pascal Jr. Tikeng Notsawo - PhD student in Machine Learning Theory at Mila and Université de Montréal."
  wide={true}
>
  <section class="home-hero">
    <div class="hero-photo-wrap">
      <img class="hero-photo" src={withBase('/images/people/pascal.jpg')} alt="Pascal Jr. Tikeng Notsawo" />
    </div>

    <div class="hero-content">
      <h1 class="hero-tagline">I learn stuff.</h1>

      <div class="hero-actions">
        <div class="hero-links">
          <a href={withBase('/about')} class="hero-link primary">About me <span aria-hidden="true">→</span></a>
          <a href={withBase('/publications')} class="hero-link secondary">Explore my research <span aria-hidden="true">→</span></a>
          <a href={withBase('/blog')} class="hero-link secondary">Blog <span aria-hidden="true">→</span></a>
        </div>
        <nav class="hero-socials" aria-label="CV and external profiles">
          <a href={SITE.cvUrl} target="_blank" rel="noopener" aria-label="CV (opens in a new tab)">
            CV <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
          <a href={SITE.scholarUrl} target="_blank" rel="noopener" aria-label="Google Scholar (opens in a new tab)">
            Google Scholar <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
          <a href={SITE.githubUrl} target="_blank" rel="noopener" aria-label="GitHub (opens in a new tab)">
            GitHub <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
          <a href={SITE.linkedinUrl} target="_blank" rel="noopener" aria-label="LinkedIn (opens in a new tab)">
            LinkedIn <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>

      <div class="research-interests">
        <h2>Research Interests</h2>
        <div class="interest-chips">
          <span class="interest-chip">Optimization</span>
          <span class="interest-chip">Generalization</span>
          <span class="interest-chip">Deep Learning Theory</span>
          <span class="interest-chip">Grokking</span>
          <span class="interest-chip">AI Alignment</span>
          <span class="interest-chip">LLM Unlearning</span>
        </div>
      </div>
    </div>
  </section>

  <aside class="math-note" aria-label="Mathematical aside">
    <p class="math-note-intro">
      If I were a mathematician like
      <a href="https://darsakthi.github.io/" target="_blank" rel="noopener">Dalton A. R. Sakthivadivel</a>,
      I would have written:
    </p>
    <blockquote class="math-quote">
      "Enter this website if and only if your personal model of mathematics is consistent with
      <a href="https://fardila.com/" target="_blank" rel="noopener">Ardila's axioms</a>."
    </blockquote>
  </aside>

  <NewsSection items={news} />

  <section>
    <div class="section-header">
      <h2>Selected Publications</h2>
      <div class="section-divider"></div>
    </div>

    <div class="stack">
      {sortedPubs.map((pub) => (
        <PublicationCard
          href={withBase(`/publications/${pub.slug}`)}
          title={pub.data.title}
          authors={pub.data.authors}
          venues={pub.data.venues}
          date={pub.data.date}
          tags={pub.data.tags}
          image={pub.data.image}
        />
      ))}
    </div>

    <p class="section-link">
      <a href={withBase('/publications')}>View all publications →</a>
    </p>
  </section>

</BaseLayout>
