---
import { resolveUrl } from '../lib/site';

interface Props {
  href: string;
  title: string;
  authors: string;
  venues: string[];
  date: string;
  tags?: string[];
  image?: string;
}

const { href, title, authors, venues, date, tags = [], image } = Astro.props;
const year = new Date(date).getFullYear();
---

<a href={href} class="pub-card">
  <div class:list={['pub-thumb', { 'pub-thumb-typographic': !image }]} aria-hidden="true">
    {image ? (
      <img src={resolveUrl(image)} alt="" loading="lazy" />
    ) : (
      <div class="pub-thumb-label">
        <span class="pub-thumb-year">{year} / Research</span>
        <span class="pub-thumb-mark">{tags[0] ?? 'Publication'}</span>
      </div>
    )}
  </div>
  <div class="pub-meta">
    <div class="pub-card-heading">
      <div class="pub-title">{title}</div>
      <span class="card-arrow" aria-hidden="true">↗</span>
    </div>
    <div class="pub-authors">{authors}</div>
    <div class="pub-venues" aria-label={venues.length > 1 ? 'Publication venues' : 'Publication venue'}>
      {venues.map(venue => <div class="pub-venue">{venue}</div>)}
    </div>
    {tags.length > 0 && (
      <div class="tags">
        {tags.slice(0, 4).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>
