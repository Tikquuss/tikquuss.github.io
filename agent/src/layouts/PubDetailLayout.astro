---
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/Giscus.astro';
import PublicationAuthors from '../components/PublicationAuthors.astro';
import { withBase } from '../lib/site';

interface AuthorContributions {
  lead?: string[];
  core?: string[];
  highlighted?: string[];
}

interface Props {
  title: string;
  authors: string;
  authorContributions?: AuthorContributions;
  venues: string[];
  date: string;
  paperUrl?: string;
  codeUrl?: string;
  projectUrl?: string;
  tags?: string[];
  description?: string;
}

const {
  title,
  authors,
  authorContributions,
  venues,
  date,
  paperUrl,
  codeUrl,
  projectUrl,
  tags = [],
  description,
} = Astro.props;

const year = new Date(date).getFullYear();
---

<BaseLayout title={title} description={description ?? title}>
  <a href={withBase('/publications')} class="back-link">← Publications</a>

  <article class="publication-detail">
    <header class="pub-detail-header">
      <p class="eyebrow">Research publication <span aria-hidden="true">/</span> {year}</p>
      <h1>{title}</h1>
      <div class="pub-detail-authors">
        <PublicationAuthors authors={authors} contributions={authorContributions} />
      </div>
      <div class="pub-detail-venues" aria-label="Published at">
        {venues.map(item => <p class="pub-detail-venue">{item}</p>)}
      </div>

      {tags.length > 0 && (
        <div class="tags" aria-label="Keywords">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}

      {(paperUrl || codeUrl || projectUrl) && (
        <div class="pub-action-links" role="group" aria-label="Publication resources">
          {paperUrl && (
            <a href={paperUrl} class="btn btn-primary" target="_blank" rel="noopener">
              Read paper <span aria-hidden="true">↗</span>
            </a>
          )}
          {codeUrl && (
            <a href={codeUrl} class="btn btn-secondary" target="_blank" rel="noopener">
              Code <span aria-hidden="true">↗</span>
            </a>
          )}
          {projectUrl && (
            <a href={projectUrl} class="btn btn-secondary" target="_blank" rel="noopener">
              Project page <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      )}
    </header>

    <div class="prose publication-content">
      <slot />
    </div>

    <Giscus />
  </article>
</BaseLayout>
