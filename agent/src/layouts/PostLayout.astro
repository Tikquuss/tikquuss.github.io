---
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/Giscus.astro';
import { formatDate } from '../lib/site';

interface Props {
  title: string;
  date: string;
  tags?: string[];
  backHref: string;
  backLabel: string;
  description?: string;
}

const { title, date, tags = [], backHref, backLabel, description } = Astro.props;

const formattedDate = formatDate(date);
---

<BaseLayout title={title} description={description ?? title}>
  <a href={backHref} class="back-link">← {backLabel}</a>

  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date}>{formattedDate}</time>
        {tags.length > 0 && (
          <div class="tags">
            {tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    <Giscus />
  </article>

  <script>
    const explanationPopovers = Array.from(
      document.querySelectorAll<HTMLElement>('.explanation-popover'),
    );
    const supportsPopover = 'showPopover' in HTMLElement.prototype;
    const viewportMargin = 12;
    const triggerGap = 12;
    // On phones, a popover opens as a sheet along the bottom of the screen, so
    // the page stays visible above it and the trigger can be scrolled into view.
    const narrowScreen = window.matchMedia('(max-width: 680px)');

    function triggerOf(popover: HTMLElement) {
      return document.querySelector<HTMLElement>(`[popovertarget="${CSS.escape(popover.id)}"]`);
    }

    function closeExplanationPopover(popover: HTMLElement) {
      if (supportsPopover) {
        popover.hidePopover();
      } else {
        popover.classList.remove('is-open');
        triggerOf(popover)?.setAttribute('aria-expanded', 'false');
      }
      triggerOf(popover)?.focus({ preventScroll: true });
    }

    // A header with the label and a close button, which stays at the top while
    // a long popover scrolls. Without JavaScript, the label comes from CSS instead.
    explanationPopovers.forEach(popover => {
      const header = document.createElement('span');
      header.className = 'explanation-popover__header';
      const label = document.createElement('span');
      label.className = 'explanation-popover__label';
      label.textContent = popover.dataset.label ?? '';
      const close = document.createElement('button');
      close.type = 'button';
      close.className = 'explanation-popover__close';
      close.setAttribute('aria-label', 'Close');
      close.textContent = '×';
      close.addEventListener('click', () => closeExplanationPopover(popover));
      header.append(label, close);
      popover.prepend(header);
      popover.classList.add('has-header');
    });

    function positionExplanationPopover(popover: HTMLElement) {
      const trigger = triggerOf(popover);
      if (!trigger) return;

      if (narrowScreen.matches) {
        popover.dataset.placement = 'sheet';
        popover.style.left = '';
        popover.style.top = '';
        popover.style.width = '';
        return;
      }

      const triggerRect = trigger.getBoundingClientRect();
      const width = Math.min(520, window.innerWidth - 2 * viewportMargin);
      popover.style.width = `${width}px`;

      const popoverRect = popover.getBoundingClientRect();
      const centeredLeft = triggerRect.left + triggerRect.width / 2 - popoverRect.width / 2;
      const left = Math.min(
        window.innerWidth - popoverRect.width - viewportMargin,
        Math.max(viewportMargin, centeredLeft),
      );
      const roomBelow = window.innerHeight - triggerRect.bottom - triggerGap - viewportMargin;
      const roomAbove = triggerRect.top - triggerGap - viewportMargin;
      const placeBelow = roomBelow >= popoverRect.height || roomBelow >= roomAbove;
      const preferredTop = placeBelow
        ? triggerRect.bottom + triggerGap
        : triggerRect.top - popoverRect.height - triggerGap;
      const top = Math.min(
        window.innerHeight - popoverRect.height - viewportMargin,
        Math.max(viewportMargin, preferredTop),
      );
      popover.dataset.placement = placeBelow ? 'below' : 'above';
      popover.style.left = `${left}px`;
      popover.style.top = `${top}px`;
    }

    function isOpen(popover: HTMLElement) {
      return supportsPopover
        ? popover.matches(':popover-open')
        : popover.classList.contains('is-open');
    }

    let positionFrame = 0;
    function positionOpenExplanations() {
      cancelAnimationFrame(positionFrame);
      positionFrame = requestAnimationFrame(() => {
        explanationPopovers.filter(isOpen).forEach(positionExplanationPopover);
      });
    }

    // In the sheet layout, scroll the page so that the trigger stays visible above the sheet.
    function revealTriggerAboveSheet(popover: HTMLElement) {
      if (!narrowScreen.matches) return;
      const trigger = triggerOf(popover);
      if (!trigger) return;
      const sheetTop = popover.getBoundingClientRect().top;
      const overlap = trigger.getBoundingClientRect().bottom + triggerGap - sheetTop;
      if (overlap > 0) window.scrollBy({ top: overlap, behavior: 'smooth' });
    }

    function openedExplanationPopover(popover: HTMLElement) {
      positionExplanationPopover(popover);
      popover.scrollTop = 0;
      revealTriggerAboveSheet(popover);
    }

    explanationPopovers.forEach(popover => {
      if (supportsPopover) {
        popover.addEventListener('toggle', () => {
          if (isOpen(popover)) openedExplanationPopover(popover);
        });
        return;
      }

      const trigger = document.querySelector<HTMLButtonElement>(
        `[popovertarget="${CSS.escape(popover.id)}"]`,
      );
      trigger?.setAttribute('aria-expanded', 'false');
      trigger?.addEventListener('click', () => {
        const opening = !popover.classList.contains('is-open');
        explanationPopovers.forEach(other => {
          other.classList.remove('is-open');
          document
            .querySelector<HTMLElement>(`[popovertarget="${CSS.escape(other.id)}"]`)
            ?.setAttribute('aria-expanded', 'false');
        });
        popover.classList.toggle('is-open', opening);
        trigger.setAttribute('aria-expanded', String(opening));
        if (opening) openedExplanationPopover(popover);
      });
    });

    if (!supportsPopover) {
      document.addEventListener('click', event => {
        if (event.target instanceof Element && event.target.closest('.explanation-note')) return;
        explanationPopovers.forEach(popover => {
          popover.classList.remove('is-open');
          document
            .querySelector<HTMLElement>(`[popovertarget="${CSS.escape(popover.id)}"]`)
            ?.setAttribute('aria-expanded', 'false');
        });
      });
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        explanationPopovers.forEach(popover => {
          popover.classList.remove('is-open');
          document
            .querySelector<HTMLElement>(`[popovertarget="${CSS.escape(popover.id)}"]`)
            ?.setAttribute('aria-expanded', 'false');
        });
      });
    }

    window.addEventListener('resize', positionOpenExplanations);
    window.addEventListener('scroll', positionOpenExplanations, { passive: true });
    narrowScreen.addEventListener('change', positionOpenExplanations);
  </script>
</BaseLayout>
